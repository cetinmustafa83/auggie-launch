# ==============================================================================
# auggie-launch Configuration Template
# ==============================================================================

# Required upstream OpenAI-compatible Chat Completions config.
# For 9router (default port 20128):
AUGGIE_LAUNCH_BASE_URL=http://localhost:20128/v1
AUGGIE_LAUNCH_MODEL=free
AUGGIE_LAUNCH_API_KEY=your-9router-or-upstream-api-key

# Optional: comma-separated key rotation.
# AUGGIE_LAUNCH_API_KEYS=key1,key2,key3

# Installed Auggie CLI binary.
# AUGGIE_BIN=auggie

# Local Python proxy port. Empty/0 means auto-pick a free local port.
# AUGGIE_LAUNCH_PORT=0

# ==============================================================================
# CodeGPT Plus (auto-detected when the base URL is api.codegpt.co)
# ==============================================================================
# CodeGPT Plus routes every chat through an agent and authenticates with the
# session token the CodeGPT VS Code extension serves locally.
#
# 1) Point the upstream at CodeGPT:
#    AUGGIE_LAUNCH_BASE_URL=https://api.codegpt.co/api/v1
#    AUGGIE_LAUNCH_API_KEY=anything            (a real token is fetched per session)
# 2) Pick an inclusive ("economy") model. They are unlimited and need no agent:
#    AUGGIE_LAUNCH_MODEL=deepseek-v4.1-flash
#
#    X-Provider is derived from the model automatically by reading the
#    extension's model catalog. Pin it only to override:
#    AUGGIE_LAUNCH_CODEGPT_PROVIDER=openrouter
#    AUGGIE_LAUNCH_CODEGPT_HARNESS=codegpt
# 3) Optional: pin the token so VS Code does not need to be open. The token is
#    long-lived (expiresAt ~ year 9999) and only changes on a fresh sign-in.
#    AUGGIE_LAUNCH_CODEGPT_TOKEN=session-xxxxxxxx.xxxxxxxx
#    # Setting the session URL to an empty value disables sidecar probing:
#    AUGGIE_LAUNCH_CODEGPT_SESSION_URL=
#    AUGGIE_LAUNCH_CODEGPT_ORG_ID=
#    AUGGIE_LAUNCH_CODEGPT_DISTINCT_ID=
#    AUGGIE_LAUNCH_CODEGPT_SIGNED_DISTINCT_ID=
#    AUGGIE_LAUNCH_CODEGPT_VERSION=3.24.70
#    AUGGIE_LAUNCH_FORCE_CODEGPT=true
# ==============================================================================
# 9router Specific Settings (Auto-detected when port is 20128 or host matches)
# ==============================================================================
# Force 9router mode even if port/URL differs:
# AUGGIE_LAUNCH_FORCE_9ROUTER=true

# Fetch available models from 9router (/v1/models) and register them in Auggie:
# AUGGIE_LAUNCH_DYNAMIC_MODELS=true

# Enable 9router Caveman mode (terse output to save input/output tokens):
# AUGGIE_LAUNCH_9ROUTER_CAVEMAN=false

# Route request to a specific 9router backend provider (e.g. anthropic, openrouter):
# AUGGIE_LAUNCH_9ROUTER_PROVIDER=

# ==============================================================================
# Modern LLM & Reasoning (DeepSeek-R1, Claude 3.7 Sonnet, o1, o3)
# ==============================================================================
# Stream reasoning deltas wrapped in  tags. Leave OFF: the CLI renders
# reasoning itself, and the raw tags otherwise leak into the transcript.
# AUGGIE_LAUNCH_STREAM_THINKING=false

# Parameter mode for max tokens: 'auto' (detects o1/o3/claude-3.7), 'true' (always max_completion_tokens), 'false' (always max_tokens)
# AUGGIE_LAUNCH_USE_COMPLETION_TOKENS=auto

# Optional upstream reasoning effort for reasoning models: low, medium, or high.
# AUGGIE_LAUNCH_REASONING_EFFORT=medium

# Model token limits exposed to Auggie CLI:
# AUGGIE_LAUNCH_MODEL_CONTEXT_TOKENS=200000
# AUGGIE_LAUNCH_MODEL_MAX_OUTPUT_TOKENS=16000

# ==============================================================================
# Proxy & Network Performance
# ==============================================================================
# Enable HTTP/1.1 persistent connection pooling with Keep-Alive (reduces TLS/TCP latency):
# AUGGIE_LAUNCH_CONNECTION_POOL=true

# Request retry & throttle limits:
# AUGGIE_LAUNCH_UPSTREAM_RETRIES=2
# AUGGIE_LAUNCH_UPSTREAM_MIN_INTERVAL_SECONDS=0.25
# AUGGIE_LAUNCH_429_FREEZE_SECONDS=60.0
# AUGGIE_LAUNCH_5XX_FREEZE_SECONDS=30.0
# Upstream request timeout in seconds (applies to both streaming and JSON calls):
# AUGGIE_LAUNCH_UPSTREAM_TIMEOUT=300
# ==============================================================================
# Session Compaction (Auggie history summarization)
# ==============================================================================
# Auggie only compacts a long session when the proxy advertises these flags.
# Disable to let the history grow unbounded (it will eventually overflow).
# AUGGIE_LAUNCH_HISTORY_SUMMARY=true
# Both default to a share of the model's real context window (trigger 60%,
# kept tail 10% capped at 400k chars), so a 1M-token model is not compacted as
# if it only had 200k. Set them to override that derivation.
# AUGGIE_LAUNCH_HISTORY_SUMMARY_TRIGGER_TOKENS=120000
# AUGGIE_LAUNCH_HISTORY_SUMMARY_MAX_HISTORY_CHARS=100000
# AUGGIE_LAUNCH_HISTORY_SUMMARY_INPUT_BUDGET_RATIO=0.6

# ==============================================================================
# Workspace & RAG / Indexing
# ==============================================================================
# IMPORTANT: RAG/indexing is disabled by default.
# complete => /find-missing reports no missing blobs and /batch-upload is acknowledged
#             without storing workspace content.
# capture  => allows Auggie to attempt uploads, but this Python launcher still does
#             not persist uploaded blob content.
AUGGIE_LAUNCH_INDEXING_MODE=complete

# Upstream identity.
# AUGGIE_LAUNCH_USER_AGENT=codex-cli
# AUGGIE_LAUNCH_UPSTREAM_APP_NAME=Codex
# AUGGIE_LAUNCH_SANITIZE_UPSTREAM_PROMPTS=false

# Optional extra system prompt prepended upstream.
# AUGGIE_LAUNCH_SYSTEM_PROMPT=

# Debug launcher/proxy behavior.
# AUGGIE_LAUNCH_VERBOSE=1
# AUGGIE_LAUNCH_DEBUG_DIR=/tmp/auggie-launch
